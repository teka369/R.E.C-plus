POSTGRES_DB=rec_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
# SEGURIDAD: JWT de acceso corto (15-30min) + refresh largo (30d) con rotación
# IMPORTANTE: Cambiar a 15m o 30m máximo en producción (actualmente 7d es inseguro)
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Dominio publico del frontend (para CORS y embedding)
CORS_ORIGIN=https://app.tu-dominio.com
EMBED_ORIGINS=https://app.tu-dominio.com

# URL publica del backend (build del cliente; enlaces absolutos si aplica)
NEXT_PUBLIC_API_BASE_URL=https://api.tu-dominio.com
NEXT_PUBLIC_EMAIL_DOMAIN=iejavieralondonobarriosevilla.edu.co

# El contenedor frontend llama al API por red Docker (proxy /api/rec)
# En Coolify suele ser http://<nombre-servicio-backend>:4001
INTERNAL_API_URL=http://backend:4001

# Backup automático de PostgreSQL (dias de retención)
BACKUP_RETENTION_DAYS=30

# ── E2E Test credentials (Playwright) ──────────────────────────────────────
# Used by r.e.c-frontend/e2e/ tests; set in CI secrets
E2E_TEACHER_EMAIL=teacher@test.edu
E2E_TEACHER_PASSWORD=Password123!
E2E_STUDENT_EMAIL=student@test.edu
E2E_STUDENT_PASSWORD=Password123!
E2E_SECRETARIA_EMAIL=secretaria@test.edu
E2E_SECRETARIA_PASSWORD=Password123!
E2E_BASE_URL=http://127.0.0.1:3000
