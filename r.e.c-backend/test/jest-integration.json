{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.integration-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@paralleldrive/cuid2|@noble/hashes)/)"
  ],
  "setupFilesAfterEnv": [
    "<rootDir>/test/ensure-jwt-env-for-tests.ts",
    "<rootDir>/test/integration/setup-integration.ts"
  ],
  "testTimeout": 30000,
  "coverageDirectory": "coverage/integration"
}
