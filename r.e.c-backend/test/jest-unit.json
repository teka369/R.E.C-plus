{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/test/unit/**/*.unit-spec.ts",
    "<rootDir>/test/unit/auth/login-tracker.util.spec.ts"
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@paralleldrive/cuid2|@noble/hashes)/)"
  ],
  "moduleNameMapper": {
    "^file-type$": "<rootDir>/test/__mocks__/file-type.mock.ts"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/**/dto/**/*.ts",
    "!src/**/*.module.ts",
    "!src/**/*.spec.ts"
  ],
  "coverageDirectory": "coverage/unit",
  "coverageReporters": ["text", "lcov", "json-summary"],
  "coverageThreshold": {
    "global": {
      "branches": 50,
      "functions": 50,
      "lines": 60,
      "statements": 60
    }
  }
}
