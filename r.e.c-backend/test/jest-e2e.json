{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "setupFilesAfterEnv": ["<rootDir>/test/ensure-jwt-env-for-tests.ts"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@paralleldrive/cuid2|@noble/hashes)/)"
  ]
}
