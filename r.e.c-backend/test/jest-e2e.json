{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "setupFilesAfterEnv": [
    "<rootDir>/test/ensure-jwt-env-for-tests.ts",
    "<rootDir>/test/e2e/setup-e2e.ts"
  ],
  "testEnvironment": "node",
  "testRegex": "test/app\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@paralleldrive/cuid2|@noble/hashes)/)"
  ]
}
