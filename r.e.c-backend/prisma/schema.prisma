generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  SECRETARIA
  PROFESOR
  ESTUDIANTE
}

// Tipos de notificación
enum NotificationType {
  GENERAL
  MATERIAL
  PERFORMANCE
  SCHEDULE
  MESSAGE
  FEEDBACK
}

// Visibilidad de materiales
enum Visibility {
  GROUP
  GRADE
}

// Tipo de material
enum MaterialType {
  PDF
  VIDEO
  LINK
  DOC
  OTHER
}

enum RecoveryRequestType {
  RECOVERY
  REINFORCEMENT
}

enum RecoveryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RecoveryActivityType {
  HOMEWORK
  EXAM
  PROJECT
  PRACTICE
}

enum RecoveryActivityStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  PROMOTED
  REPEATING
  CLOSED
}

enum AcademicPeriodType {
  TERM
  RECOVERY
  INTERSESSION
}

enum AcademicPeriodStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum FeedbackTipo {
  POSITIVA
  NEGATIVA
  INFORMATIVA
  SEGUIMIENTO
}

enum FeedbackEstado {
  PENDIENTE
  ATENDIDA
}

enum SyllabusStatus {
  BORRADOR
  ACTIVO
  ARCHIVADO
}

enum EvaluacionTipo {
  PARCIAL
  EXAMEN_FINAL
  TALLER
  PROYECTO
  QUIZ
  PRACTICA
}

enum GradingMode {
  SIMPLE
  COMPETENCY
}

enum CompetencyCategory {
  COGNITIVE
  PROCEDURAL
  ATTITUDINAL
  SELF_EVAL
  CO_EVAL
}

model User {
  id                 Int      @id @default(autoincrement())
  publicId           String   @unique @default(uuid())
  institutionId      Int?
  nombres            String
  apellidos          String
  email              String   @unique
  codigo             String   @unique @default(cuid())
  password           String
  role               Role     @default(ESTUDIANTE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?
  // Relaciones académicas
  studentGroups      StudentGroup[]
  teacherAssignments TeacherAssignment[]
  teacherOfferingAssignments TeacherOfferingAssignment[]
  materials          StudyMaterial[]
  syllabi            Syllabus[]
  directedGroups     Group[]  @relation("GroupDirector")
  // Relaciones de comunicación
  feedbacksGiven     Feedback[] @relation("FeedbackTeacher")
  feedbacksReceived  Feedback[] @relation("FeedbackStudent")
  sentMessages       Message[]  @relation("MessageSender")
  receivedMessages   Message[]  @relation("MessageRecipient")
  notifications      Notification[]
  // Schedule
  scheduleEntries    WeeklyScheduleEntry[] @relation("ScheduleEntryTeacher")
  scheduleNotes      ScheduleNote[] @relation("ScheduleNoteTeacher")
  scheduleEvents     ScheduleEvent[] @relation("ScheduleEventTeacher")
  recoveryRequestsAsStudent RecoveryRequest[] @relation("RecoveryStudent")
  recoveryRequestsAsTeacher RecoveryRequest[] @relation("RecoveryTeacher")
  recoveryActivitiesCreated RecoveryActivity[] @relation("RecoveryActivityTeacher")
  recoveryMessagesSent RecoveryMessage[] @relation("RecoveryMessageAuthor")
  academicRecords StudentAcademicRecord[] @relation("AcademicRecordStudent")
  academicRecordsUpdated StudentAcademicRecord[] @relation("AcademicRecordTeacher")
  evaluationGradesUpdated EvaluationGrade[] @relation("EvaluationGradeUpdatedBy")
  authSessions       AuthSession[]
  passwordResetTokens PasswordResetToken[]
  institution        Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
  @@index([publicId])
  @@index([deletedAt])
}

model AuthSession {
  id           Int          @id @default(autoincrement())
  userId       Int
  jti          String       @unique
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy   AuthSession? @relation("AuthSessionRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  previous     AuthSession[] @relation("AuthSessionRotation")

  @@index([userId, revokedAt, expiresAt])
}

model Institution {
  id          Int             @id @default(autoincrement())
  publicId    String          @unique @default(uuid())
  nombre      String
  slug        String          @unique
  codigo      String?         @unique
  dominio     String?
  maxUsers    Int             @default(500)
  activa      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  users       User[]
  grades      Grade[]
  groups      Group[]
  subjects    Subject[]
  periods     AcademicPeriod[]
  gradingPolicy InstitutionGradingPolicy?

  @@index([publicId])
  @@index([deletedAt])
}

model InstitutionGradingPolicy {
  id                   Int       @id @default(autoincrement())
  institutionId        Int       @unique
  gradeScaleMax        Float     @default(5)
  passingThreshold     Float     @default(3.0)
  allowClosedPeriodEdits Boolean @default(false)
  allowFinalOverride   Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  institution          Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  gradingMode        GradingMode @default(SIMPLE)
  competencyWeights  Json        @default("{\"COGNITIVE\":30,\"PROCEDURAL\":30,\"ATTITUDINAL\":30,\"SELF_EVAL\":5,\"CO_EVAL\":5}")
}

// Modelos académicos

model AcademicPeriod {
  id               Int                  @id @default(autoincrement())
  institutionId    Int
  nombre           String
  codigo           String
  tipo             AcademicPeriodType   @default(TERM)
  estado           AcademicPeriodStatus @default(DRAFT)
  fechaInicio      DateTime
  fechaFin         DateTime
  fechaCierre      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  studentGroups    StudentGroup[]
  groupSubjects    GroupSubject[]
  academicOfferings AcademicOffering[]
  gradePerformances GradePerformance[]
  recoveryConfigs   RecoveryConfig[]    @relation("RecoveryConfigPeriod")
  recoverySchedules RecoverySchedule[]  @relation("RecoverySchedulePeriod")
  syllabi           Syllabus[]
  institution       Institution         @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, codigo])
  @@index([institutionId])
  // Queries frecuentes: WHERE institutionId = ? AND estado = 'ACTIVE'
  @@index([institutionId, estado])
}

model Grade {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique
  institutionId Int
  nombre    String
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, nombre])
  @@index([institutionId])
}

model Group {
  id                 Int      @id @default(autoincrement())
  publicId           String   @unique
  institutionId      Int
  nombre             String
  gradeId            Int
  grade              Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  directorId         Int?
  director           User?    @relation("GroupDirector", fields: [directorId], references: [id], onDelete: SetNull)
  students           StudentGroup[]
  subjects           GroupSubject[]
  academicOfferings  AcademicOffering[]
  teacherAssignments TeacherAssignment[]
  info               GroupInfo?
  studyMaterials     StudyMaterial[]
  syllabi            Syllabus[]
  feedbacks          Feedback[]
  // Schedule relations
  scheduleEntries    WeeklyScheduleEntry[]
  scheduleNotes      ScheduleNote[]
  events             ScheduleEvent[]
  recoveryRequests   RecoveryRequest[]
  performances       GradePerformance[]
  academicRecords    StudentAcademicRecord[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([nombre, gradeId])
  @@index([institutionId])
}

model GradePerformance {
  id                                Int      @id @default(autoincrement())
  groupId                           Int
  academicPeriodId                  Int
  promedioGeneral                   Float?
  asistenciaPromedio                Float?
  aprobacion                        Float?
  mejorAsignatura                   String?
  inasistenciasJustificadas         Int?
  inasistenciasInjustificadas       Int?
  porcentajeCursoMayorAsistencia    Float?
  variacionPromedio                 Float?
  variacionAprobacion               Float?
  reduccionAusencias                Float?
  tendenciaGeneral                  String?
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  group                             Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academicPeriod                    AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  topStudents                       PerformanceTopStudent[]

  @@unique([groupId, academicPeriodId])
}

model Subject {
  id                 Int      @id @default(autoincrement())
  publicId           String   @unique
  institutionId      Int
  nombre             String
  codigo             String?
  groupSubjects      GroupSubject[]
  academicOfferings  AcademicOffering[]
  teacherAssignments TeacherAssignment[]
  studyMaterials     StudyMaterial[]
  syllabi            Syllabus[]
  // Schedule
  scheduleEntries    WeeklyScheduleEntry[]
  feedbacks          Feedback[]
  recoveryRequests   RecoveryRequest[]
  academicRecords    StudentAcademicRecord[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?
  institution        Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, nombre])
  @@index([institutionId])
  @@index([deletedAt])
}

model StudentAcademicRecord {
  id                     Int      @id @default(autoincrement())
  publicId               String   @unique @default(uuid())
  studentId              Int
  groupId                Int
  subjectId              Int
  updatedByTeacherId     Int?
  notaFinal              Float?
  finalOverride          Float?
  finalSource            String   @default("NONE")
  finalUpdatedAt         DateTime?
  progresoMateria        Float?
  inasistenciasJustificadas   Int  @default(0)
  inasistenciasInjustificadas Int  @default(0)
  observaciones          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  academicOfferingId     Int?
  student                User              @relation("AcademicRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group                  Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject                Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedByTeacher       User?             @relation("AcademicRecordTeacher", fields: [updatedByTeacherId], references: [id], onDelete: SetNull)
  academicOffering       AcademicOffering? @relation(fields: [academicOfferingId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId, subjectId])
  @@index([studentId])
  @@index([groupId])
  @@index([subjectId])
  @@index([academicOfferingId])
  @@index([publicId])
}

// Asignación de estudiante a grupo
model StudentGroup {
  id               Int               @id @default(autoincrement())
  studentId        Int
  groupId          Int
  academicPeriodId Int
  status           EnrollmentStatus  @default(ACTIVE)
  endedAt          DateTime?
  student          User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group            Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod    @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  evaluationGrades EvaluationGrade[]
  createdAt        DateTime          @default(now())
  deletedAt        DateTime?

  @@unique([studentId, groupId, academicPeriodId])
  @@index([studentId, academicPeriodId])
  @@index([groupId, academicPeriodId])
  @@index([deletedAt])
}

// Materias que tiene un grupo
model GroupSubject {
  id               Int             @id @default(autoincrement())
  groupId          Int
  subjectId        Int
  academicPeriodId Int?
  weeklyHours      Int?
  isActive         Boolean         @default(true)
  group            Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)
  academicOfferings AcademicOffering[]
  createdAt        DateTime        @default(now())

  @@unique([groupId, subjectId])
  @@index([academicPeriodId])
}

model AcademicOffering {
  id               Int             @id @default(autoincrement())
  groupId          Int
  subjectId        Int
  academicPeriodId Int
  groupSubjectId   Int?
  weeklyHours      Int?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  group            Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject          Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicPeriod   AcademicPeriod  @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  groupSubject     GroupSubject?   @relation(fields: [groupSubjectId], references: [id], onDelete: SetNull)
  teacherAssignments     TeacherAssignment[]
  teacherOfferingAssignments TeacherOfferingAssignment[]
  studyMaterials         StudyMaterial[]
  syllabi                Syllabus[]
  studentAcademicRecords StudentAcademicRecord[]
  academicEvaluations    AcademicEvaluation[]

  @@unique([groupId, subjectId, academicPeriodId])
  @@index([groupSubjectId])
  @@index([deletedAt])
}

// Asignaciones de profesor: qué grupos y materias enseña
model TeacherAssignment {
  id                Int               @id @default(autoincrement())
  teacherId         Int
  groupId           Int
  subjectId         Int
  academicOfferingId Int?
  teacher           User              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group             Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject           Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicOffering  AcademicOffering? @relation(fields: [academicOfferingId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())

  @@unique([teacherId, groupId, subjectId])
  @@index([academicOfferingId])
}

// Fase 4FN: relación canónica Docente <-> Oferta (sin redundancia grupo/materia)
model TeacherOfferingAssignment {
  id                Int              @id @default(autoincrement())
  teacherId         Int
  academicOfferingId Int
  createdAt         DateTime         @default(now())

  teacher           User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicOffering  AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)

  @@unique([teacherId, academicOfferingId])
  @@index([academicOfferingId])
}

// Materiales de estudio
model StudyMaterial {
  id                 Int           @id @default(autoincrement())
  subjectId          Int
  groupId            Int
  teacherId          Int
  academicOfferingId Int?
  title              String
  description        String?
  type               MaterialType  @default(LINK)
  resourceUrl        String?
  imageUrl           String?
  filePath           String?
  visibility         Visibility    @default(GROUP)
  views              Int           @default(0)
  downloads          Int           @default(0)
  createdAt          DateTime      @default(now())
  deletedAt          DateTime?

  subject            Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group              Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher            User             @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicOffering   AcademicOffering? @relation(fields: [academicOfferingId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicOfferingId])
  // Queries frecuentes: WHERE groupId = ? AND subjectId = ?
  @@index([groupId, subjectId])
  @@index([deletedAt])
}

// Temarios
model Syllabus {
  id                 Int      @id @default(autoincrement())
  subjectId          Int
  groupId            Int
  teacherId          Int
  academicOfferingId Int?
  title              String
  academicPeriodId   Int?
  status             SyllabusStatus @default(BORRADOR)
  duration           String?
  content            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subject            Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group              Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher            User              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicOffering   AcademicOffering? @relation(fields: [academicOfferingId], references: [id], onDelete: SetNull)
  academicPeriod     AcademicPeriod?   @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicOfferingId])
  @@index([academicPeriodId])
}

// Información general del grupo (ligas)
model GroupInfo {
  groupId    Int      @id
  summary    String?
  updatedAt  DateTime @updatedAt

  group           Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  infoHighlights  GroupInfoHighlight[]
  infoMetrics     GroupInfoMetric[]
  infoLinks       GroupInfoLink[]
}

// Observaciones/Feedback del profesor al estudiante
model Feedback {
  id           Int      @id @default(autoincrement())
  teacherId    Int
  studentId    Int
  groupId      Int
  subjectId    Int?
  title        String
  content      String
  tipo         FeedbackTipo   @default(INFORMATIVA)
  estado       FeedbackEstado @default(PENDIENTE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  feedbackStrengths    FeedbackStrength[]
  feedbackImprovements FeedbackImprovement[]

  teacher    User     @relation("FeedbackTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student    User     @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([teacherId])
  @@index([groupId])
  // Queries frecuentes: ORDER BY createdAt DESC filtrado por groupId
  @@index([groupId, createdAt(sort: Desc)])
  // Optimización para listFeedbackByStudent con ordenamiento
  @@index([studentId, createdAt(sort: Desc)])
}
model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?

  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId])
}

// Notificaciones para usuarios
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  deletedAt DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  // Queries frecuentes: WHERE userId = ? AND readAt IS NULL
  @@index([userId, readAt])
  @@index([deletedAt])
}

// Horario semanal por grupo (plantilla semanal)
model WeeklyScheduleEntry {
  id           Int      @id @default(autoincrement())
  groupId      Int
  teacherId    Int
  dayOfWeek    Int      // 1=Lunes .. 7=Domingo
  startMinutes Int      // minutos desde medianoche
  endMinutes   Int      // minutos desde medianoche, debe ser > startMinutes (validación a nivel app)
  title        String?
  subjectId    Int?
  location     String?
  createdAt    DateTime @default(now())
  deletedAt DateTime?

  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher      User     @relation("ScheduleEntryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([groupId, dayOfWeek])
  @@index([deletedAt])
}

// Notas importantes visibles en la página de horario
model ScheduleNote {
  id        Int      @id @default(autoincrement())
  groupId   Int
  teacherId Int
  content   String
  createdAt DateTime @default(now())

  deletedAt DateTime?

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   User     @relation("ScheduleNoteTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([deletedAt])
}

// Eventos asociados al módulo de horarios
model ScheduleEvent {
  id        Int      @id @default(autoincrement())
  groupId   Int
  teacherId Int
  title     String
  description String?
  startAt   DateTime
  endAt     DateTime
  location  String?
  createdAt DateTime @default(now())
  deletedAt DateTime?

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   User     @relation("ScheduleEventTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([startAt])
  @@index([deletedAt])
}

// Solicitudes de recuperación/refuerzo académico
model RecoveryRequest {
  id             Int                   @id @default(autoincrement())
  studentId      Int
  teacherId      Int
  groupId        Int
  subjectId      Int
  type           RecoveryRequestType   @default(RECOVERY)
  reason         String
  status         RecoveryRequestStatus @default(PENDING)
  teacherComment String?
  requestedAt    DateTime              @default(now())
  respondedAt    DateTime?
  dueDate        DateTime?
  finalScore     Float?
  deletedAt      DateTime?

  student        User                  @relation("RecoveryStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User                  @relation("RecoveryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  group          Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject        Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  activities     RecoveryActivity[]
  messages       RecoveryMessage[]

  @@index([studentId])
  @@index([teacherId])
  @@index([groupId])
  @@index([subjectId])
  @@index([status])
  // Queries frecuentes: WHERE groupId = ? AND status = 'PENDING'
  @@index([groupId, status])
  @@index([deletedAt])
}
model RecoveryActivity {
  id             Int                  @id @default(autoincrement())
  requestId      Int
  teacherId      Int
  title          String
  description    String
  activityType   RecoveryActivityType @default(HOMEWORK)
  status         RecoveryActivityStatus @default(PENDING)
  startAt        DateTime?
  dueAt          DateTime
  score          Float?
  attachmentUrl  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  request        RecoveryRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacher        User                 @relation("RecoveryActivityTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  attachment     RecoveryActivityAttachment?

  @@index([requestId])
  @@index([teacherId])
  @@index([status])
  @@index([dueAt])
}

// Archivo adjunto por actividad de recuperación
model RecoveryActivityAttachment {
  id           Int      @id @default(autoincrement())
  activityId   Int      @unique
  originalName String
  mimeType     String
  filePath     String
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  activity     RecoveryActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([uploadedAt])
}

// Seguimiento conversacional de una solicitud
model RecoveryMessage {
  id             Int      @id @default(autoincrement())
  requestId      Int
  authorId       Int
  body           String
  createdAt      DateTime @default(now())

  request        RecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author         User            @relation("RecoveryMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
  @@index([createdAt])
}

// Configuración del periodo de recuperaciones (singleton)
model RecoveryConfig {
  id               Int             @id @default(autoincrement())
  startAt          DateTime
  endAt            DateTime
  updatedById      Int?
  academicPeriodId Int             @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  academicPeriod   AcademicPeriod  @relation("RecoveryConfigPeriod", fields: [academicPeriodId], references: [id], onDelete: Cascade)
}

// Archivo de horario de recuperación (singleton)
model RecoverySchedule {
  id               Int             @id @default(autoincrement())
  originalName     String
  mimeType         String
  filePath         String
  uploadedById     Int?
  academicPeriodId Int             @unique
  uploadedAt       DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  academicPeriod   AcademicPeriod  @relation("RecoverySchedulePeriod", fields: [academicPeriodId], references: [id], onDelete: Cascade)
}

// ───────────────────────────────────────────────────────────────────
// Fase 4: Evaluaciones estructuradas por oferta académica
// ───────────────────────────────────────────────────────────────────

// Plantilla de evaluación asociada a una oferta académica (reemplaza parcial1-4 fijos)
model AcademicEvaluation {
  id                 Int              @id @default(autoincrement())
  academicOfferingId Int
  titulo             String
  tipo               EvaluacionTipo   @default(PARCIAL)
  porcentaje         Float?
  orden              Int              @default(0)
  termSlot           Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  competencyCategory CompetencyCategory?

  academicOffering   AcademicOffering @relation(fields: [academicOfferingId], references: [id], onDelete: Cascade)
  calificaciones     EvaluationGrade[]

  @@unique([academicOfferingId, orden])
  @@index([academicOfferingId, termSlot, orden])
}

// Nota de un estudiante en una evaluación concreta (reemplaza gradesJson)
model EvaluationGrade {
  id                   Int                @id @default(autoincrement())
  publicId             String             @unique @default(uuid())
  academicEvaluationId Int
  studentGroupId       Int
  updatedByTeacherId   Int?
  nota                 Float
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  academicEvaluation   AcademicEvaluation @relation(fields: [academicEvaluationId], references: [id], onDelete: Cascade)
  studentGroup         StudentGroup       @relation(fields: [studentGroupId], references: [id], onDelete: Cascade)
  updatedByTeacher     User?              @relation("EvaluationGradeUpdatedBy", fields: [updatedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([academicEvaluationId, studentGroupId])
  @@index([studentGroupId])
  @@index([publicId])
}

// ───────────────────────────────────────────────────────────────────
// Fase 5: Estudiantes destacados (normaliza GradePerformance.estudiantesDestacados)
// ───────────────────────────────────────────────────────────────────

model PerformanceTopStudent {
  id                 Int              @id @default(autoincrement())
  gradePerformanceId Int
  fullName           String
  average            Float
  rank               Int              @default(1)
  createdAt          DateTime         @default(now())

  gradePerformance   GradePerformance @relation(fields: [gradePerformanceId], references: [id], onDelete: Cascade)

  @@index([gradePerformanceId])
}

// ───────────────────────────────────────────────────────────────────
// Fase 6: Registros hijos de GroupInfo (reemplaza highlights/metrics/links Json)
// ───────────────────────────────────────────────────────────────────

model GroupInfoHighlight {
  id        Int       @id @default(autoincrement())
  groupId   Int
  texto     String
  orden     Int       @default(0)
  createdAt DateTime  @default(now())

  groupInfo GroupInfo @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@index([groupId])
}

model GroupInfoMetric {
  id        Int       @id @default(autoincrement())
  groupId   Int
  etiqueta  String
  valor     String
  orden     Int       @default(0)
  createdAt DateTime  @default(now())

  groupInfo GroupInfo @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@index([groupId])
}

model GroupInfoLink {
  id        Int       @id @default(autoincrement())
  groupId   Int
  titulo    String
  url       String
  orden     Int       @default(0)
  createdAt DateTime  @default(now())

  groupInfo GroupInfo @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────────────
// Fase 10: Normalización de Feedback.strengths/improvements
// ─────────────────────────────────────────────────────────────────────

model FeedbackStrength {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  texto      String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model FeedbackImprovement {
  id         Int      @id @default(autoincrement())
  feedbackId Int
  texto      String
  orden      Int      @default(0)
  createdAt  DateTime @default(now())

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([feedbackId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ───────────────────────────────────────────────────────────────────
// Audit Trail — append-only log para cambios con valor legal
// ───────────────────────────────────────────────────────────────────

model AuditLog {
  id            Int      @id @default(autoincrement())
  userId        Int?
  institutionId Int?
  action        String   // CREATE, UPDATE, DELETE
  tableName     String   // nombre del modelo Prisma afectado
  recordId      String   // ID del registro (string para soportar Int y futuro UUID)
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([institutionId])
  @@index([tableName])
  @@index([createdAt])
}
