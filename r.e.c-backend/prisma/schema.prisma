generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SECRETARIA
  PROFESOR
  ESTUDIANTE
}

// Tipos de notificación
enum NotificationType {
  GENERAL
  MATERIAL
  PERFORMANCE
  SCHEDULE
  MESSAGE
  FEEDBACK
}

// Visibilidad de materiales
enum Visibility {
  GROUP
  GRADE
}

// Tipo de material
enum MaterialType {
  PDF
  VIDEO
  LINK
  DOC
  OTHER
}

enum RecoveryRequestType {
  RECOVERY
  REINFORCEMENT
}

enum RecoveryRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum RecoveryActivityType {
  HOMEWORK
  EXAM
  PROJECT
  PRACTICE
}

enum RecoveryActivityStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

model User {
  id                 Int      @id @default(autoincrement())
  nombres            String
  apellidos          String
  email              String   @unique
  documento_identidad String  @unique
  telefono           String?  // Solo para profesores
  password           String
  role               Role     @default(ESTUDIANTE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  // Relaciones académicas
  studentGroups      StudentGroup[]
  teacherAssignments TeacherAssignment[]
  materials          StudyMaterial[]
  syllabi            Syllabus[]
  directedGroups     Group[]  @relation("GroupDirector")
  // Relaciones de comunicación
  feedbacksGiven     Feedback[] @relation("FeedbackTeacher")
  feedbacksReceived  Feedback[] @relation("FeedbackStudent")
  sentMessages       Message[]  @relation("MessageSender")
  receivedMessages   Message[]  @relation("MessageRecipient")
  notifications      Notification[]
  // Schedule
  scheduleEntries    WeeklyScheduleEntry[] @relation("ScheduleEntryTeacher")
  scheduleNotes      ScheduleNote[] @relation("ScheduleNoteTeacher")
  scheduleEvents     ScheduleEvent[] @relation("ScheduleEventTeacher")
  recoveryRequestsAsStudent RecoveryRequest[] @relation("RecoveryStudent")
  recoveryRequestsAsTeacher RecoveryRequest[] @relation("RecoveryTeacher")
  recoveryActivitiesCreated RecoveryActivity[] @relation("RecoveryActivityTeacher")
  recoveryMessagesSent RecoveryMessage[] @relation("RecoveryMessageAuthor")
  academicRecords StudentAcademicRecord[] @relation("AcademicRecordStudent")
  academicRecordsUpdated StudentAcademicRecord[] @relation("AcademicRecordTeacher")
}

// Modelos académicos

model Grade {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  groups    Group[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id                 Int      @id @default(autoincrement())
  nombre             String
  gradeId            Int
  grade              Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  directorId         Int?
  director           User?    @relation("GroupDirector", fields: [directorId], references: [id], onDelete: SetNull)
  students           StudentGroup[]
  subjects           GroupSubject[]
  teacherAssignments TeacherAssignment[]
  info               GroupInfo?
  studyMaterials     StudyMaterial[]
  syllabi            Syllabus[]
  feedbacks          Feedback[]
  // Schedule relations
  scheduleEntries    WeeklyScheduleEntry[]
  scheduleNotes      ScheduleNote[]
  events             ScheduleEvent[]
  recoveryRequests   RecoveryRequest[]
  performance        GradePerformance?
  academicRecords    StudentAcademicRecord[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([nombre, gradeId])
}

model GradePerformance {
  id                                Int      @id @default(autoincrement())
  groupId                           Int      @unique
  promedioGeneral                   Float?
  asistenciaPromedio                Float?
  aprobacion                        Float?
  mejorAsignatura                   String?
  estudiantesDestacados             String?
  inasistenciasJustificadas         Int?
  inasistenciasInjustificadas       Int?
  porcentajeCursoMayorAsistencia    Float?
  variacionPromedio                 Float?
  variacionAprobacion               Float?
  reduccionAusencias                Float?
  tendenciaGeneral                  String?
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  group                             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Subject {
  id                 Int      @id @default(autoincrement())
  nombre             String   @unique
  codigo             String?
  groupSubjects      GroupSubject[]
  teacherAssignments TeacherAssignment[]
  studyMaterials     StudyMaterial[]
  syllabi            Syllabus[]
  // Schedule
  scheduleEntries    WeeklyScheduleEntry[]
  feedbacks          Feedback[]
  recoveryRequests   RecoveryRequest[]
  academicRecords    StudentAcademicRecord[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model StudentAcademicRecord {
  id                     Int      @id @default(autoincrement())
  studentId              Int
  groupId                Int
  subjectId              Int
  updatedByTeacherId     Int?
  parcial1               Float?
  parcial2               Float?
  parcial3               Float?
  parcial4               Float?
  notaFinal              Float?
  progresoMateria        Float?
  inasistenciasJustificadas   Int  @default(0)
  inasistenciasInjustificadas Int  @default(0)
  observaciones          String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  student                User     @relation("AcademicRecordStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group                  Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject                Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedByTeacher       User?    @relation("AcademicRecordTeacher", fields: [updatedByTeacherId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId, subjectId])
  @@index([studentId])
  @@index([groupId])
  @@index([subjectId])
}

// Asignación de estudiante a grupo
model StudentGroup {
  id         Int      @id @default(autoincrement())
  studentId  Int
  groupId    Int
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studentId, groupId])
}

// Materias que tiene un grupo
model GroupSubject {
  id         Int      @id @default(autoincrement())
  groupId    Int
  subjectId  Int
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([groupId, subjectId])
}

// Asignaciones de profesor: qué grupos y materias enseña
model TeacherAssignment {
  id         Int      @id @default(autoincrement())
  teacherId  Int
  groupId    Int
  subjectId  Int
  teacher    User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([teacherId, groupId, subjectId])
}

// Materiales de estudio
model StudyMaterial {
  id          Int           @id @default(autoincrement())
  subjectId   Int
  groupId     Int
  teacherId   Int
  title       String
  description String?
  type        MaterialType  @default(LINK)
  resourceUrl String?
  imageUrl    String?
  filePath    String?
  visibility  Visibility    @default(GROUP)
  views       Int           @default(0)
  downloads   Int           @default(0)
  createdAt   DateTime      @default(now())

  subject     Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     User          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
}

// Temarios
model Syllabus {
  id          Int      @id @default(autoincrement())
  subjectId   Int
  groupId     Int
  teacherId   Int
  title       String
  content     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([subjectId])
  @@index([teacherId])
}

// Información general del grupo (ligas)
model GroupInfo {
  groupId    Int      @id
  summary    String?
  highlights Json?
  metrics    Json?
  links      Json?
  updatedAt  DateTime @updatedAt

  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

// Observaciones/Feedback del profesor al estudiante
model Feedback {
  id         Int      @id @default(autoincrement())
  teacherId  Int
  studentId  Int
  groupId    Int
  subjectId  Int?
  title      String
  content    String
  strengths  Json?
  improvements Json?
  createdAt  DateTime @default(now())

  teacher    User     @relation("FeedbackTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student    User     @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([teacherId])
  @@index([groupId])
}

// Mensajería directa entre usuarios
model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  recipientId Int
  content     String
  createdAt   DateTime @default(now())
  readAt      DateTime?

  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([senderId])
}

// Notificaciones para usuarios
model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  type      NotificationType @default(GENERAL)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

// Horario semanal por grupo (plantilla semanal)
model WeeklyScheduleEntry {
  id           Int      @id @default(autoincrement())
  groupId      Int
  teacherId    Int
  dayOfWeek    Int      // 1=Lunes .. 7=Domingo
  startMinutes Int      // minutos desde medianoche
  endMinutes   Int      // minutos desde medianoche, debe ser > startMinutes (validación a nivel app)
  title        String?
  subjectId    Int?
  location     String?
  createdAt    DateTime @default(now())

  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher      User     @relation("ScheduleEntryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([groupId, dayOfWeek])
}

// Notas importantes visibles en la página de horario
model ScheduleNote {
  id        Int      @id @default(autoincrement())
  groupId   Int
  teacherId Int
  content   String
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   User     @relation("ScheduleNoteTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// Eventos asociados al módulo de horarios
model ScheduleEvent {
  id        Int      @id @default(autoincrement())
  groupId   Int
  teacherId Int
  title     String
  description String?
  startAt   DateTime
  endAt     DateTime
  location  String?
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacher   User     @relation("ScheduleEventTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([startAt])
}

// Solicitudes de recuperación/refuerzo académico
model RecoveryRequest {
  id             Int                   @id @default(autoincrement())
  studentId      Int
  teacherId      Int
  groupId        Int
  subjectId      Int
  type           RecoveryRequestType   @default(RECOVERY)
  reason         String
  status         RecoveryRequestStatus @default(PENDING)
  teacherComment String?
  requestedAt    DateTime              @default(now())
  respondedAt    DateTime?
  dueDate        DateTime?
  finalScore     Float?

  student        User                  @relation("RecoveryStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher        User                  @relation("RecoveryTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  group          Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subject        Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  activities     RecoveryActivity[]
  messages       RecoveryMessage[]

  @@index([studentId])
  @@index([teacherId])
  @@index([groupId])
  @@index([subjectId])
  @@index([status])
}

// Actividades asignadas dentro de una solicitud
model RecoveryActivity {
  id             Int                  @id @default(autoincrement())
  requestId      Int
  teacherId      Int
  title          String
  description    String
  activityType   RecoveryActivityType @default(HOMEWORK)
  status         RecoveryActivityStatus @default(PENDING)
  startAt        DateTime?
  dueAt          DateTime
  score          Float?
  attachmentUrl  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  request        RecoveryRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  teacher        User                 @relation("RecoveryActivityTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  attachment     RecoveryActivityAttachment?

  @@index([requestId])
  @@index([teacherId])
  @@index([status])
  @@index([dueAt])
}

// Archivo adjunto por actividad de recuperación
model RecoveryActivityAttachment {
  id           Int      @id @default(autoincrement())
  activityId   Int      @unique
  originalName String
  mimeType     String
  fileContent  Bytes
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  activity     RecoveryActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([uploadedAt])
}

// Seguimiento conversacional de una solicitud
model RecoveryMessage {
  id             Int      @id @default(autoincrement())
  requestId      Int
  authorId       Int
  body           String
  createdAt      DateTime @default(now())

  request        RecoveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author         User            @relation("RecoveryMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorId])
  @@index([createdAt])
}

// Configuración del periodo de recuperaciones (singleton)
model RecoveryConfig {
  id          Int      @id @default(1)
  startAt     DateTime
  endAt       DateTime
  updatedById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Archivo de horario de recuperación (singleton)
model RecoverySchedule {
  id          Int      @id @default(1)
  originalName String
  mimeType    String
  fileContent Bytes
  uploadedById Int?
  uploadedAt  DateTime @default(now())
}
