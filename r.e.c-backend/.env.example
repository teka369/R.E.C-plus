NODE_ENV=production
PORT=4000
# VPS: Postgres en Docker mapeado a localhost:5432 (ver r.e.c-backend/docker-compose.yml)
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/rec_db?schema=public&connection_limit=10&pool_timeout=10
DATABASE_DIRECT_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/rec_db?schema=public
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/recedu_test?schema=public
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Access token: 15 minutos. Mantenerlo corto previene uso de institutionId stale tras
# transferencia de usuario entre instituciones. El refresh token (30d) con rotación
# activa garantiza continuidad de sesión sin comprometer seguridad.
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES=30d

# Secreto para GET /health/metrics (header x-internal-key). Obligatorio salvo NODE_ENV=test.
# Generar valor largo aleatorio; no reutilizar JWT_SECRET.
INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_KEY
CORS_ORIGIN=https://recedu.co,https://www.recedu.co
FRONTEND_URL=https://recedu.co
# Deep link del correo de recuperación (recedu://reset?token=...). Debe coincidir con un scheme en app.json de la app móvil.
MOBILE_PASSWORD_RESET_SCHEME=recedu
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM=R.E.C <noreply@recedu.co>
EMBED_ORIGINS=https://recedu.co https://www.recedu.co
TRUST_PROXY=1

# Sentry (opcional — para tracking de errores en producción)
SENTRY_DSN=

# Redis (recomendado en VPS): throttler persistente + caché académica con invalidación por patrón.
# Levantar: en r.e.c-backend → docker compose up -d redis  (o el stack completo). Puerto 127.0.0.1:6379
# Sin REDIS_URL: caché en memoria y delByPattern no borra claves → listas académicas pueden quedar obsoletas.
REDIS_URL=redis://127.0.0.1:6379

JWT_ISSUER=recedu.co
JWT_AUDIENCE=recedu-api
JWT_EXPIRES=15m
