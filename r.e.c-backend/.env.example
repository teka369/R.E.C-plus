NODE_ENV=production
PORT=4001
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/rec_db?schema=public&connection_limit=10&pool_timeout=10
DATABASE_DIRECT_URL=postgresql://postgres:CHANGE_ME@postgres:5432/rec_db?schema=public
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@postgres:5432/recedu_test?schema=public
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
# Access token: 15 minutos. Mantenerlo corto previene uso de institutionId stale tras
# transferencia de usuario entre instituciones. El refresh token (30d) con rotación
# activa garantiza continuidad de sesión sin comprometer seguridad.
JWT_EXPIRES=15m
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES=30d
CORS_ORIGIN=https://recedu.co
FRONTEND_URL=https://recedu.co
RESEND_API_KEY=re_c7ULC9pw_DaJRMBZd41TrJPz9PKCyrUAA
RESEND_FROM=R.E.C <noreply@recedu.co>
EMBED_ORIGINS=https://recedu.co

# Sentry (opcional — para tracking de errores en producción)
SENTRY_DSN=

# Redis (opcional — si no se define, usa caché en memoria)
REDIS_URL=redis://localhost:6379
