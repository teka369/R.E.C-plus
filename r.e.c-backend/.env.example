# Copia a r.e.c-backend/.env. No se commitea. Solo placeholders.
# Genera secretos con: node scripts/generate-secrets.mjs

NODE_ENV=development
PORT=4000

# En un solo servidor las dos URLs pueden ser iguales.
# Si usas un pooler, DATABASE_URL apunta al pooler y DATABASE_DIRECT_URL a la conexión directa.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/rec_db?schema=public
DATABASE_DIRECT_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/rec_db?schema=public
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/recedu_test?schema=public

JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_ISSUER=recedu
JWT_AUDIENCE=recedu-app

INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_KEY

# Orígenes del frontend, separados por coma, sin barra final.
CORS_ORIGIN=http://localhost:3000
EMBED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Obligatorio para el correo de restablecimiento. Sin clave, el envío falla y queda en el log.
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM=Recedu <noreply@example.com>
MOBILE_PASSWORD_RESET_SCHEME=recedu

# 1 si hay un proxy inverso delante. Vacío en local.
TRUST_PROXY=

# Opcional. Sin Redis, el rate limit, la caché y los intentos de login viven en memoria del proceso.
# Con varias instancias eso no se comparte y el límite de login deja de ser global.
# REDIS_URL=redis://127.0.0.1:6379

# Opcional. Sin DSN no se envían errores a Sentry.
SENTRY_DSN=

# Opcional. Sin el JSON, las notificaciones push quedan desactivadas.
# El archivo firebase-service-account.json va en el directorio de trabajo del backend y no se commitea.
