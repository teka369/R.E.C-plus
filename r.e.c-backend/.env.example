# Copia a r.e.c-backend/.env (no se commitea). Placeholders solamente.
# Producción: pega los mismos nombres en el dashboard de Render. Ver DEPLOY.md.

NODE_ENV=development
PORT=4000

# Local: las dos URLs pueden ser iguales.
# Neon runtime (pooling): host con -pooler, sslmode=require y pgbouncer=true.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/rec_db?schema=public
# Neon migraciones (directo, sin pooler). Prisma migrate deploy usa esta.
# DATABASE_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/rec_db?schema=public
DATABASE_URL_TEST=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/recedu_test?schema=public

# Generar con: node scripts/generate-secrets.mjs
# JWT_SECRET debe ser idéntico en Vercel. JWT_REFRESH_SECRET distinto y >= 32 caracteres.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_SECRET
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_ISSUER=recedu
JWT_AUDIENCE=recedu-app

INTERNAL_API_KEY=CHANGE_ME_LONG_RANDOM_INTERNAL_KEY

# Origen del frontend en Vercel. Varios separados por coma. Sin barra final.
CORS_ORIGIN=http://localhost:3000
EMBED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM=R.E.C <noreply@example.com>
MOBILE_PASSWORD_RESET_SCHEME=recedu

# Render está detrás de un proxy. En local puedes dejarlo vacío.
TRUST_PROXY=1

# Opcional. Sin Redis el rate limit y la caché viven en memoria del proceso.
# REDIS_URL=redis://127.0.0.1:6379
SENTRY_DSN=
