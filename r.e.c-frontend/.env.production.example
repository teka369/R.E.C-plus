# Copiar a .env.production en el servidor antes de `npm run build`.
# El BFF /api/rec en Next reenvía al Nest interno (INTERNAL_API_URL).

NEXT_PUBLIC_SITE_URL=https://recedu.co
# Mismo dominio registrable que el sitio (sin https). Necesario para WebSocket a api.* con cookie rec_token.
# SESSION_COOKIE_DOMAIN=recedu.co
INTERNAL_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_EMAIL_DOMAIN=iejavieralondonobarriosevilla.edu.co

# Obligatorio en producción: mismo valor que JWT_SECRET del backend (verify de cookies en Route Handlers).
JWT_SECRET=CHANGE_ME_SAME_AS_BACKEND_JWT_SECRET

# Google Analytics 4 (opcional). Solo se carga si está definido.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Opcional
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
