# Copia a r.e.c-frontend/.env.local (no se commitea).
# En Vercel pega estas variables en Project Settings. Ver DEPLOY.md.

# Socket.IO habla directo con Render. El resto del browser usa el BFF /api/rec.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Servidor Next → Nest. En Vercel: https://<servicio>.onrender.com
INTERNAL_API_URL=http://127.0.0.1:4000

# Mismo valor que JWT_SECRET del backend. Solo servidor (no NEXT_PUBLIC_).
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# No definir SESSION_COOKIE_DOMAIN si el front está en *.vercel.app y el API en *.onrender.com.
# SESSION_COOKIE_DOMAIN=

# En Vercel=1 para que el BFF use X-Real-IP que pone la plataforma, no el X-Forwarded-For del browser.
# TRUST_PROXY_HEADERS=1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_DOMAIN=example.edu.co

# NEXT_PUBLIC_TUTORIAL_VIDEO_URL=
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_SENTRY_DSN=
