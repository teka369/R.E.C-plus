NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# URL del vídeo tutorial (YouTube u otro embed). Opcional: se usa en el modal de bienvenida y en /tutorial#video
# NEXT_PUBLIC_TUTORIAL_VIDEO_URL=https://www.youtube.com/watch?v=XXXXXXXXXXX

# URL pública del sitio (opcional). Mejora metadatos y enlaces absolutos en producción, p. ej. https://recedu.co
# NEXT_PUBLIC_SITE_URL=https://recedu.co
NEXT_PUBLIC_EMAIL_DOMAIN=iejavieralondonobarriosevilla.edu.co

# Obligatorio para login: copia EXACTAMENTE la misma línea JWT_SECRET=... de r.e.c-backend/.env
# Sin esto, POST /api/auth/session devuelve 401 aunque el backend acepte /auth/login.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Destino del proxy BFF /api/rec (misma máquina en local)
INTERNAL_API_URL=http://localhost:4000
