# Copia a r.e.c-frontend/.env.local. No se commitea.

# URL pública del API Nest. El navegador la usa para Socket.IO.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# URL que el servidor Next usa para hablar con Nest. En la misma máquina puede ser loopback.
INTERNAL_API_URL=http://127.0.0.1:4000

# Mismo valor que JWT_SECRET del backend. Solo servidor. No uses NEXT_PUBLIC_.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Solo si el frontend y el API comparten un dominio propio.
# SESSION_COOKIE_DOMAIN=

# 1 únicamente si un proxy de confianza reescribe X-Real-IP. No lo actives en local.
# TRUST_PROXY_HEADERS=1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_EMAIL_DOMAIN=example.edu.co

# NEXT_PUBLIC_SENTRY_DSN=
